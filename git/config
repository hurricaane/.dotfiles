[user]
  email = dossouyannick@gmail.com
  name = Yannick Dossou

[core]
  compression = 9
  preloadindex = true
  pager = delta

[advice]
  addEmptyPathspec = false
  pushNonFastForward = false
  statusHints = false

[init]
	defaultBranch = main

[status]
  branch = true
  showStash = true
  showUntrackedFiles = all

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
  interHunkContext = 10
	tool = codediff

[difftool "codediff"]
	cmd = nvim \"$LOCAL\" \"$REMOTE\" +\"CodeDiff file $LOCAL $REMOTE\"

[commit]
  verbose = true

[push]
  autoSetupRemote = true
  followTags = true
  useForceIfIncludes = true

[pull]
  rebase = true

[rebase]
  autoStash = true
  missingCommitsCheck = warn

[fetch]
  prune = true
  pruneTags = true
  all = true

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[log]
  abbrevCommit = true
  graphColors = blue,yellow,cyan,magenta,green,red

[color "branch"]
  current = magenta
  local = default
  remote = yellow
  upstream = green
  plain = blue

[interactive]
  diffFilter = delta --color-only --features=interactive
  singleKey = true

[delta]
  navigate = true  # use n and N to move between diff sections
  dark = true      # or light = true, or omit for auto-detection
  line-numbers = true
  hyperlinks = true
  side-by-side = true

[delta "interactive"]
  keep-plus-minus-markers = false

[merge]
  conflictstyle = zdiff3
	tool = codediff

[mergetool "codediff"]
	cmd = nvim \"$MERGED\" -c \"CodeDiff merge \\\"$MERGED\\\"\"

[alias]
  clone-for-worktrees = "!bash $HOME/dotfiles/scripts/git-clone-bare-for-worktrees.sh"
  init-for-worktrees = "!bash $HOME/dotfiles/scripts/git-init-bare-for-worktrees.sh"
  glmr = "push --push-option merge_request.create --push-option merge_request.target=main --push-option merge_request.assign=yaou --push-option merge_request.remove_source_branch"

[credential]
	helper = 
	helper = /usr/local/bin/git-credential-manager
	credentialStore = gpg

[credential "https://dev.azure.com"]
	useHttpPath = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
